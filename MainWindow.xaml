<Controls:MetroWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    Title="Device Inspector"
    Width="1920" Height="1032"
    MinWidth="1024" MinHeight="640"
    WindowStartupLocation="CenterScreen"
    TitleCharacterCasing="Normal"
    GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    NonActiveGlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    BorderThickness="1"
    ShowIconOnTitleBar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Dark.Steel.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Contrast overrides. One value passes in both themes: #7F7F7F is 4.0:1 on white and 3.8:1 on #252525
                 (control borders need 3:1), and white title text is 7.0:1 on #595959 (the inactive title bar).
                 The start script passes every resource whose key starts with 'SuiteTheme.' to Initialize-SuiteTheme. -->
            <SolidColorBrush x:Key="MahApps.Brushes.TextBox.Border" Color="#7F7F7F"/>
            <SolidColorBrush x:Key="MahApps.Brushes.WindowTitle.NonActive" Color="#595959"/>

            <!-- The one button template and the one button style. Every Button of the window takes ThemedButtonStyle
                 or a style that is based on it. No color literal and no Opacity is allowed here: the colors come from the
                 MahApps theme resources, so the same markup works in the dark and the light theme. Hover and keyboard focus
                 show the theme foreground as border color. Pressed shows the accent blue with white text.
                 A disabled button shows MahApps.Brushes.Gray.MouseOver text (4.5:1 or more in both themes) and a Gray2
                 border, because the MahApps disabled state fades the text below 4.5:1. -->
            <ControlTemplate x:Key="ThemedButtonTemplate" TargetType="Button">
                <Border Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                    <ContentPresenter Name="Cp"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      SnapsToDevicePixels="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsMouseOver" Value="True"/>
                            <Condition Property="IsEnabled" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                    </MultiTrigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MahApps.Brushes.AccentBase}"/>
                        <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="ThemedButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Square}">

                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
                <Setter Property="Template" Value="{StaticResource ThemedButtonTemplate}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Controls:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A disabled text box shows dimmed text. WCAG 1.4.3 exempts a disabled control from the 4.5:1 rule, and the window tests require it to look dimmed. -->
            <Style TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A disabled combo box shows dimmed text (see the text box style). -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource MahApps.Styles.ComboBox}">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Check box text keeps 4.5:1 when disabled. -->
            <Style TargetType="CheckBox" BasedOn="{StaticResource MahApps.Styles.CheckBox}">
                <Setter Property="Controls:CheckBoxHelper.ForegroundUncheckedDisabled" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                <Setter Property="Controls:CheckBoxHelper.ForegroundCheckedDisabled" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                <Setter Property="Controls:CheckBoxHelper.ForegroundIndeterminateDisabled" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
            </Style>

            <!-- A highlighted and a selected combo box item show white text (IdealForeground) on the theme highlight. -->
            <Style x:Key="ThemedComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource MahApps.Styles.ComboBoxItem}">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- The sidebar buttons. SuiteCommon sets their colors for the theme (Update-SidebarButtonTheme). -->
            <Style x:Key="ViewButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="8,2,8,2"/>
                <Setter Property="Padding" Value="12,0,12,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style x:Key="OptionsButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewButtonStyle}">
                <Setter Property="Margin" Value="8,24,8,2"/>
            </Style>

            <Style x:Key="SquareInlineButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}">
                <Setter Property="Template" Value="{DynamicResource SuiteNeutralButtonTemplate}"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="Padding" Value="12,0,12,0"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="LogButtonStyle" TargetType="Button" BasedOn="{StaticResource SquareInlineButtonStyle}">
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <!-- The one primary button style: the accent base with white text. SuiteAccentButtonTemplate keeps it blue in
                 hover and pressed: each state is one darker step. -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SquareInlineButtonStyle}">
                <Setter Property="Template" Value="{DynamicResource SuiteAccentButtonTemplate}"/>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.AccentBase}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.AccentBase}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ViewDataGridRow" TargetType="DataGridRow"
                   BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ViewDataGrid" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Extended"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ColumnHeaderHeight" Value="26"/>
                <Setter Property="RowHeight" Value="24"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource MahApps.Brushes.Gray8}"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="RowStyle" Value="{StaticResource ViewDataGridRow}"/>
            </Style>

            <!-- A selected cell shows white text (IdealForeground) on the theme highlight, the same as a selected row. -->
            <Style x:Key="GridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
                <Setter Property="Padding" Value="6,0,6,0"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Cell text that does not fit ends with an ellipsis, and the tooltip shows the full text. A cell with no text has no tooltip. -->
            <Style x:Key="GridCellTextStyle" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                        <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Column headers keep the case of their text (Title Case). MahApps makes them upper case by default. -->
            <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader}">
                <Setter Property="Padding" Value="6,0,6,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Controls:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
            </Style>

            <Style x:Key="DetailTextStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Field titles are bold, the same in both themes. The value next to a title keeps the normal body style. -->
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,14,14,12">
                    <TextBlock x:Name="txtAppTitle" Text="Device Inspector"
                               FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="txtVersion" Text="" FontSize="10"
                               Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,14">
                    <Separator Margin="0,8,0,10"/>
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock Text="Enable Actions" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"/>
                        <Controls:ToggleSwitch x:Name="toggleActions"
                                               DockPanel.Dock="Right"
                                               IsOn="False"
                                               OnContent="" OffContent=""
                                               MinWidth="0"
                                               ToolTip="Turn on the actions that change the device or the site, each after a confirmation."/>
                    </DockPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="txtThemeLabel" Text="Dark Theme"
                                   DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"/>
                        <Controls:ToggleSwitch x:Name="toggleTheme"
                                               DockPanel.Dock="Right"
                                               IsOn="True"
                                               OnContent="" OffContent=""
                                               MinWidth="0"
                                               ToolTip="Switch between the dark theme and the light theme."/>
                    </DockPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button x:Name="btnViewDeviceList"  Content="Device List"  Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Search the devices of the site by name or collection."/>
                        <Button x:Name="btnViewDevice"      Content="Device"       Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Show the operating system, the client health, the discovery data and the hardware inventory of the device."/>
                        <Button x:Name="btnViewApps"        Content="Applications" Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Show the applications that the device lists in its uninstall registry keys."/>
                        <Button x:Name="btnViewUpdates"     Content="Updates"      Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Show the software updates that the site requires and the updates pending on the device."/>
                        <Button x:Name="btnViewCollections" Content="Collections"  Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Show the collections of the device and the deployments that target them."/>
                        <Button x:Name="btnViewProblems"    Content="Problems"     Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Show the parts of the inspection that failed."/>

                        <Button x:Name="btnOptions" Content="Options"
                                Style="{StaticResource OptionsButtonStyle}"
                                ToolTip="Set the SMS Provider and the site code."/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource MahApps.Brushes.Gray8}"/>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource MahApps.Brushes.Gray10}" Padding="16,12,16,10">
                <StackPanel>
                    <TextBlock x:Name="txtModuleTitle" Text="Device" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtModuleSubtitle"
                               Text="Enter a device name, then select Inspect. The inspection only reads."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Padding="16,10,16,10">
                <!-- Two rows, so that the boxes keep room at the minimum width (1024): the Device and SMS Provider boxes
                     share the first row with Inspect; Site Only and the exports sit under them. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnInspect" Grid.Row="0" Grid.Column="0" Content="Inspect" Margin="0,0,12,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="Get the data of the device and the site. Nothing changes."/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Device" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtDevice" Height="26" Grid.Row="0" Grid.Column="2" MinWidth="140" FontSize="12" Padding="6,4,6,4" Margin="0,0,12,0"
                             Controls:TextBoxHelper.Watermark="For example WS01"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="SMS Provider" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtSiteServer" Height="26" Grid.Row="0" Grid.Column="4" MinWidth="200" FontSize="12" Padding="6,4,6,4" IsReadOnly="True"
                             Controls:TextBoxHelper.Watermark="Set in Options"
                             ToolTip="The SMS Provider from Options. Change it in Options."/>
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox x:Name="chkSiteOnly" Content="Site Only" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"
                                  ToolTip="Skip the connection to the device and read only the site."/>
                        <Button x:Name="btnExportJson" Content="Export JSON" Style="{StaticResource SquareInlineButtonStyle}" Margin="0,0,12,0"
                                ToolTip="Save the inspection as a JSON file."/>
                        <Button x:Name="btnExportHtml" Content="Export HTML" Style="{StaticResource SquareInlineButtonStyle}" Margin="0"
                                ToolTip="Save the inspection as an HTML report."/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Running actions: shown only while a device action runs. A run ends, its row goes away. -->
            <Border x:Name="panelRuns" Grid.Row="2" Visibility="Collapsed" Padding="16,0,16,6">
                <StackPanel>
                    <TextBlock x:Name="lblRuns" Text="Running Actions" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DataGrid x:Name="gridRuns" MaxHeight="100" SelectionMode="Single"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}"
                              ToolTip="Show the actions that run on devices now.">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Device" Width="Auto" MinWidth="70" MaxWidth="160" Binding="{Binding ComputerName}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Action" Width="Auto" MinWidth="120" MaxWidth="360" Binding="{Binding Action}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Mode" Width="Auto" MaxWidth="200" MinWidth="60" Binding="{Binding Mode}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Started" Width="Auto" MaxWidth="200" MinWidth="70" Binding="{Binding StartedAt}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="ID" Width="Auto" MaxWidth="200" MinWidth="60" Binding="{Binding ActionId}"/>
                            <DataGridTemplateColumn Header="" Width="*" MinWidth="0" CanUserResize="False" CanUserSort="False" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Margin="8,0,8,0">

                <!-- ============================================================ -->
                <!-- View: Device list                                            -->
                <!-- ============================================================ -->
                <Grid x:Name="viewDeviceList" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="8,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtListName" Height="26" Grid.Column="0" FontSize="12" Padding="6,4,6,4" Margin="0,0,8,0"
                                 Controls:TextBoxHelper.Watermark="Name or wildcard, for example WS*"/>
                        <TextBox x:Name="txtListCollection" Height="26" Grid.Column="1" FontSize="12" Padding="6,4,6,4" Margin="0,0,8,0"
                                 Controls:TextBoxHelper.Watermark="Collection ID (optional)"/>
                        <Button x:Name="btnListSearch" Grid.Column="2" Content="Search"
                                Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="Get the matching devices from the site. Nothing changes."/>
                        <Button x:Name="btnListInspect" Grid.Column="3" Content="Inspect Selected"
                                Style="{StaticResource SquareInlineButtonStyle}" Margin="0"
                                ToolTip="Inspect the selected device."/>
                    </Grid>
                    <TextBlock x:Name="txtListSummary" Grid.Row="1" FontSize="12" TextWrapping="Wrap" Margin="8,0,8,8"
                               Text="Enter a name pattern or a collection ID, then select Search. The search uses the SMS Provider and the site code."/>
                    <DataGrid x:Name="gridDeviceList" Grid.Row="2" SelectionMode="Single"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Device" Width="Auto" MinWidth="70" MaxWidth="200" Binding="{Binding Name}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Resource ID" Width="Auto" MaxWidth="200" Binding="{Binding ResourceId}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Client" Width="Auto" MaxWidth="200" Binding="{Binding Client}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Active" Width="Auto" MaxWidth="200" Binding="{Binding Active}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Client Version" Width="Auto" MaxWidth="200" Binding="{Binding ClientVersion}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Operating System" Width="Auto" MinWidth="100" MaxWidth="420" Binding="{Binding OperatingSystem}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Last Logon User" Width="Auto" MinWidth="80" MaxWidth="200" Binding="{Binding LastLogonUser}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Last Active (UTC)" Width="Auto" MaxWidth="200" Binding="{Binding LastActive}"/>
                            <DataGridTemplateColumn Header="" Width="*" MinWidth="0" CanUserResize="False" CanUserSort="False" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============================================================ -->
                <!-- View: Device                                                 -->
                <!-- ============================================================ -->
                <Grid x:Name="viewDevice" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="txtSummary" Grid.Row="0" FontSize="12" TextWrapping="Wrap" Margin="8,0,8,10"
                               Text="No inspection yet."/>
                    <WrapPanel x:Name="panelDeviceActions" Grid.Row="1" Margin="8,0,8,10">
                        <Button x:Name="btnPolicyUpdate" Content="Machine Policy Cycle..."
                                Style="{StaticResource SquareInlineButtonStyle}"
                                ToolTip="Start the Machine Policy Retrieval &amp; Evaluation Cycle on the device (needs Enable Actions)."/>
                        <Button x:Name="btnFullInventory" Content="Full Hardware Inventory..."
                                Style="{StaticResource SquareInlineButtonStyle}"
                                ToolTip="Run the Hardware inventory cycle (full resynchronization) on the device (needs Enable Actions)."/>
                        <Button x:Name="btnRepairInventory" Content="Repair Inventory..."
                                Style="{StaticResource SquareInlineButtonStyle}"
                                ToolTip="Run the Hardware inventory cycle (full resynchronization) when the inventory check says Corrupt (needs Enable Actions)."/>
                    </WrapPanel>
                    <DataGrid x:Name="gridFacts" Grid.Row="2"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Group" Width="Auto" MinWidth="100" MaxWidth="260" Binding="{Binding Group}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Property" Width="Auto" MinWidth="120" MaxWidth="320" Binding="{Binding Name}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Value" Width="*" MinWidth="160" Binding="{Binding Value}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============================================================ -->
                <!-- View: Applications                                           -->
                <!-- ============================================================ -->
                <Grid x:Name="viewApps" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="8,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtAppFilter" Height="26" Grid.Column="0" FontSize="12" Padding="6,4,6,4" Margin="0,0,8,0"
                                 Controls:TextBoxHelper.Watermark="Filter by application name..."/>
                        <ComboBox x:Name="cboAppType" Grid.Column="1" Width="180" FontSize="12"
                                  ItemContainerStyle="{StaticResource ThemedComboBoxItemStyle}"
                                  ToolTip="Limit the rows by installer type.">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="MSI"/>
                            <ComboBoxItem Content="EXE"/>
                        </ComboBox>
                    </Grid>
                    <DataGrid x:Name="gridApps" Grid.Row="1"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="menuUninstallApp" Header="Uninstall..." IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
                                <MenuItem x:Name="menuRepairApp"    Header="Repair..."    IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Application" Width="Auto" MinWidth="140" MaxWidth="520" Binding="{Binding Name}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Version" Width="Auto" MinWidth="60" MaxWidth="120" Binding="{Binding Version}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Publisher" Width="Auto" MinWidth="80" MaxWidth="240" Binding="{Binding Publisher}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Install Date" Width="Auto" MaxWidth="200" Binding="{Binding InstallDate}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Type" Width="Auto" MaxWidth="200" Binding="{Binding Type}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="View" Width="Auto" MaxWidth="200" Binding="{Binding View}"/>
                            <DataGridTemplateColumn Header="" Width="*" MinWidth="0" CanUserResize="False" CanUserSort="False" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============================================================ -->
                <!-- View: Updates                                                -->
                <!-- ============================================================ -->
                <Grid x:Name="viewUpdates" Visibility="Collapsed">
                    <DataGrid x:Name="gridUpdates"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="menuInstallSelected" Header="Install Selected Pending Updates..." IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
                                <MenuItem x:Name="menuInstallAll"      Header="Install All Pending Updates..."      IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Source" Width="Auto" MaxWidth="200" Binding="{Binding Source}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Article" Width="Auto" MaxWidth="200" Binding="{Binding Article}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Severity" Width="Auto" MaxWidth="200" Binding="{Binding Severity}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="State" Width="Auto" MinWidth="70" MaxWidth="170" Binding="{Binding State}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Deadline (UTC)" Width="Auto" MaxWidth="200" Binding="{Binding Deadline}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Title" Width="*" MinWidth="140" Binding="{Binding Title}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============================================================ -->
                <!-- View: Collections                                            -->
                <!-- ============================================================ -->
                <Grid x:Name="viewCollections" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="8,0,8,8">
                        <Button x:Name="btnAddCollection" Content="Add to Collection..."
                                Style="{StaticResource SquareInlineButtonStyle}"
                                ToolTip="Add a direct membership rule for the device to a device collection (needs Enable Actions)."/>
                    </WrapPanel>
                    <DataGrid x:Name="gridCollections" Grid.Row="1"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="menuRemoveCollection" Header="Remove from Collection..." IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
                                <MenuItem x:Name="menuAddCollection" Header="Add to Collection..." IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Collection ID" Width="Auto" MinWidth="90" MaxWidth="140" Binding="{Binding CollectionId}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Collection" Width="Auto" MinWidth="140" MaxWidth="600" Binding="{Binding Name}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Membership" Width="Auto" MinWidth="90" MaxWidth="170" Binding="{Binding Membership}"/>
                            <DataGridTemplateColumn Header="" Width="*" MinWidth="0" CanUserResize="False" CanUserSort="False" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource MahApps.Brushes.Gray8}"
                                  ResizeDirection="Rows"/>
                    <DataGrid x:Name="gridDeployments" Grid.Row="3"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Deployment" Width="Auto" MinWidth="140" MaxWidth="520" Binding="{Binding Name}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Type" Width="Auto" MinWidth="70" MaxWidth="150" Binding="{Binding Type}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Intent" Width="Auto" MaxWidth="200" Binding="{Binding Intent}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Collection" Width="Auto" MinWidth="120" MaxWidth="360" Binding="{Binding Collection}"/>
                            <DataGridTextColumn ElementStyle="{StaticResource GridCellTextStyle}" Header="Deadline (UTC)" Width="Auto" MaxWidth="200" Binding="{Binding Deadline}"/>
                            <DataGridTemplateColumn Header="" Width="*" MinWidth="0" CanUserResize="False" CanUserSort="False" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============================================================ -->
                <!-- View: Problems                                               -->
                <!-- ============================================================ -->
                <Grid x:Name="viewProblems" Visibility="Collapsed">
                    <TextBox x:Name="txtProblems" Style="{StaticResource DetailTextStyle}"
                             Text="No inspection yet."/>
                </Grid>

                <Border x:Name="progressOverlay"
                        Visibility="Collapsed"
                        IsHitTestVisible="True"
                        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                        Opacity="0.92">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Controls:ProgressRing IsActive="True" Width="56" Height="56"
                                               Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                        <TextBlock x:Name="txtProgressTitle"
                                   Text="Inspecting..."
                                   FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0"/>
                        <TextBlock x:Name="txtProgressStep"
                                   Text=""
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray1}"/>
                        <Button x:Name="btnCancelWork" Content="Cancel" Style="{StaticResource SquareInlineButtonStyle}" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource MahApps.Brushes.Gray8}"
                          ResizeDirection="Rows"/>

            <Border Grid.Row="5">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,2,4,2">
                        <TextBlock x:Name="lblLogOutput" DockPanel.Dock="Left" Text="Log Output"
                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="8,4,0,4"/>
                        <Button x:Name="btnOpenLog" DockPanel.Dock="Right" Content="Open Log File"
                                Style="{StaticResource LogButtonStyle}"
                                ToolTip="Open the log file of this session."/>
                    </DockPanel>
                    <TextBox x:Name="txtLog"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="11"
                             BorderThickness="0"
                             Margin="4,0,4,4"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="6" Padding="8,4,8,4"
                    Background="{DynamicResource MahApps.Brushes.Gray10}">
                <TextBlock x:Name="txtStatus" Text="Ready."/>
            </Border>
        </Grid>
    </Grid>

</Controls:MetroWindow>