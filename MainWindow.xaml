<Controls:MetroWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    Title="Device Inspector"
    Width="1320" Height="820"
    MinWidth="1024" MinHeight="640"
    WindowStartupLocation="CenterScreen"
    TitleCharacterCasing="Normal"
    GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    NonActiveGlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    BorderThickness="1"
    ShowIconOnTitleBar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Dark.Steel.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Contrast overrides. One value passes in both themes: #7F7F7F is 4.0:1 on white and 3.8:1 on #252525
                 (control borders need 3:1), and white title text is 7.0:1 on #595959 (the inactive title bar).
                 The start script passes every resource whose key starts with 'SuiteTheme.' to Initialize-SuiteTheme:
                 the default inactive light title bar #4BA3E0 gives white text 2.6:1. -->
            <SolidColorBrush x:Key="SuiteTheme.TitleBarInactive" Color="#557595"/>
            <SolidColorBrush x:Key="MahApps.Brushes.TextBox.Border" Color="#7F7F7F"/>
            <SolidColorBrush x:Key="MahApps.Brushes.WindowTitle.NonActive" Color="#595959"/>

            <!-- The one button template and the one button style. Every Button of the window takes ThemedButtonStyle
                 or a style that is based on it. No color literal and no Opacity is allowed here: the colors come from the
                 MahApps theme resources, so the same markup works in the dark and the light theme. Hover and keyboard focus
                 show the theme foreground as border color. Pressed swaps the theme foreground and the theme background.
                 A disabled button shows MahApps.Brushes.Gray.MouseOver text (4.5:1 or more in both themes) and a Gray2
                 border, because the MahApps disabled state fades the text below 4.5:1. -->
            <ControlTemplate x:Key="ThemedButtonTemplate" TargetType="Button">
                <Border Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                    <ContentPresenter Name="Cp"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      SnapsToDevicePixels="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                        <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="ThemedButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Square}">
                <Setter Property="Template" Value="{StaticResource ThemedButtonTemplate}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Controls:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Check box text keeps 4.5:1 when disabled. -->
            <Style TargetType="CheckBox" BasedOn="{StaticResource MahApps.Styles.CheckBox}">
                <Setter Property="Controls:CheckBoxHelper.ForegroundUncheckedDisabled" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                <Setter Property="Controls:CheckBoxHelper.ForegroundCheckedDisabled" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                <Setter Property="Controls:CheckBoxHelper.ForegroundIndeterminateDisabled" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
            </Style>

            <!-- A highlighted and a selected combo box item show white text (IdealForeground) on the theme highlight. -->
            <Style x:Key="ThemedComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource MahApps.Styles.ComboBoxItem}">
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- The sidebar buttons. SuiteCommon sets their colors for the theme (Update-SidebarButtonTheme). -->
            <Style x:Key="ViewButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}">
                <Setter Property="Height" Value="42"/>
                <Setter Property="Margin" Value="8,3,8,3"/>
                <Setter Property="Padding" Value="12,0,12,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style x:Key="OptionsButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewButtonStyle}">
                <Setter Property="Margin" Value="8,24,8,3"/>
            </Style>

            <Style x:Key="SquareInlineButtonStyle" TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}">
                <Setter Property="Height" Value="28"/>
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="Padding" Value="12,0,12,0"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="LogButtonStyle" TargetType="Button" BasedOn="{StaticResource SquareInlineButtonStyle}">
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <!-- The one primary button style: the theme highlight (#4A5763 dark, #00589F light) with white text, 7:1 on both.
                 The border is the theme foreground, because the highlight alone is 2.1:1 on the dark window. -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SquareInlineButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray.MouseOver}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ViewDataGridRow" TargetType="DataGridRow"
                   BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ViewDataGrid" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Extended"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ColumnHeaderHeight" Value="30"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource MahApps.Brushes.Gray8}"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="RowStyle" Value="{StaticResource ViewDataGridRow}"/>
            </Style>

            <!-- A selected cell shows white text (IdealForeground) on the theme highlight, the same as a selected row. -->
            <Style x:Key="GridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
                <Setter Property="Padding" Value="6,0,6,0"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Highlight}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Column headers keep the case of their text (Title Case). MahApps makes them upper case by default. -->
            <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader}">
                <Setter Property="Padding" Value="6,0,6,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Controls:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
            </Style>

            <Style x:Key="DetailTextStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8"/>
            </Style>

            <!-- Field titles are bold, the same in both themes. The value next to a title keeps the normal body style. -->
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,14,14,12">
                    <TextBlock x:Name="txtAppTitle" Text="Device Inspector"
                               FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="txtVersion" Text="" FontSize="10"
                               Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,14">
                    <Separator Margin="0,8,0,10"/>
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock Text="Enable Actions" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"/>
                        <Controls:ToggleSwitch x:Name="toggleActions"
                                               DockPanel.Dock="Right"
                                               IsOn="False"
                                               OnContent="" OffContent=""
                                               MinWidth="0"
                                               ToolTip="Turn on the actions that change the device or the site, each after a confirmation."/>
                    </DockPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="txtThemeLabel" Text="Dark Theme"
                                   DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"/>
                        <Controls:ToggleSwitch x:Name="toggleTheme"
                                               DockPanel.Dock="Right"
                                               IsOn="True"
                                               OnContent="" OffContent=""
                                               MinWidth="0"
                                               ToolTip="Switch between the dark theme and the light theme."/>
                    </DockPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button x:Name="btnViewDeviceList"  Content="Device List"  Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Search the devices of the site by name or collection."/>
                        <Button x:Name="btnViewDevice"      Content="Device"       Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Show the operating system, the client health and the site record of the device."/>
                        <Button x:Name="btnViewApps"        Content="Applications" Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Show the applications that the device lists in its uninstall registry keys."/>
                        <Button x:Name="btnViewUpdates"     Content="Updates"      Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Show the software updates that the site requires and the updates pending on the device."/>
                        <Button x:Name="btnViewCollections" Content="Collections"  Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Show the collections of the device and the deployments that target them."/>
                        <Button x:Name="btnViewProblems"    Content="Problems"     Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Show the parts of the inspection that failed."/>

                        <Button x:Name="btnOptions" Content="Options"
                                Style="{StaticResource OptionsButtonStyle}"
                                ToolTip="Set the site server and the site code."/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource MahApps.Brushes.Gray8}"/>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource MahApps.Brushes.Gray10}" Padding="16,12,16,10">
                <StackPanel>
                    <TextBlock x:Name="txtModuleTitle" Text="Device" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="txtModuleSubtitle"
                               Text="Enter a device name, then click Inspect. The inspection only reads."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Padding="16,10,16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnInspect" Grid.Column="0" Content="Inspect"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="Read the device and the site without any change."/>
                    <TextBlock Grid.Column="1" Text="Device" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="txtDevice" Grid.Column="2" FontSize="12" Padding="6,4,6,4" Margin="0,0,12,0"
                             Controls:TextBoxHelper.Watermark="e.g. WS01"/>
                    <TextBlock Grid.Column="3" Text="Site Server" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtSiteServer" Grid.Column="4" FontSize="12" Padding="6,4,6,4" Margin="0,0,12,0"
                             Controls:TextBoxHelper.Watermark="e.g. sms01.example.com"/>
                    <CheckBox x:Name="chkSiteOnly" Grid.Column="5" Content="Site Only" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center"
                              ToolTip="Skip the connection to the device and read only the site."/>
                    <Button x:Name="btnExportJson" Grid.Column="6" Content="Export JSON" Style="{StaticResource SquareInlineButtonStyle}"
                            ToolTip="Save the inspection as a JSON file."/>
                    <Button x:Name="btnExportHtml" Grid.Column="7" Content="Export HTML" Style="{StaticResource SquareInlineButtonStyle}" Margin="0"
                            ToolTip="Save the inspection as an HTML report."/>
                </Grid>
            </Border>

            <!-- Running actions: shown only while a device action runs. A run ends, its row goes away. -->
            <Border x:Name="panelRuns" Grid.Row="2" Visibility="Collapsed" Padding="16,0,16,6">
                <StackPanel>
                    <TextBlock x:Name="lblRuns" Text="Running Actions" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                    <DataGrid x:Name="gridRuns" MaxHeight="100" SelectionMode="Single" ColumnHeaderHeight="24"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}"
                              ToolTip="Show the actions that run on devices now.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device"  Width="2*"  Binding="{Binding ComputerName}"/>
                            <DataGridTextColumn Header="Action"  Width="3*"  Binding="{Binding Action}"/>
                            <DataGridTextColumn Header="Mode"    Width="80"  Binding="{Binding Mode}"/>
                            <DataGridTextColumn Header="Started" Width="80"  Binding="{Binding StartedAt}"/>
                            <DataGridTextColumn Header="ID"      Width="100" Binding="{Binding ActionId}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Margin="8,0,8,0">

                <!-- ============================================================ -->
                <!-- View: Device list                                            -->
                <!-- ============================================================ -->
                <Grid x:Name="viewDeviceList" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="8,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtListName" Grid.Column="0" FontSize="12" Padding="6,4,6,4" Margin="0,0,8,0"
                                 Controls:TextBoxHelper.Watermark="Name, * as a wildcard, e.g. WS*"/>
                        <TextBox x:Name="txtListCollection" Grid.Column="1" FontSize="12" Padding="6,4,6,4" Margin="0,0,8,0"
                                 Controls:TextBoxHelper.Watermark="Collection ID (optional)"/>
                        <Button x:Name="btnListSearch" Grid.Column="2" Content="Search"
                                Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="Read the matching devices from the site without any change."/>
                        <Button x:Name="btnListInspect" Grid.Column="3" Content="Inspect Selected"
                                Style="{StaticResource SquareInlineButtonStyle}" Margin="0"
                                ToolTip="Inspect the selected device."/>
                    </Grid>
                    <TextBlock x:Name="txtListSummary" Grid.Row="1" FontSize="12" TextWrapping="Wrap" Margin="8,0,8,8"
                               Text="Enter a name pattern or a collection ID, then select Search. The search uses the site server and the site code."/>
                    <DataGrid x:Name="gridDeviceList" Grid.Row="2" SelectionMode="Single"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device"           Width="2*"  Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Resource ID"      Width="100" Binding="{Binding ResourceId}"/>
                            <DataGridTextColumn Header="Client"           Width="60"  Binding="{Binding Client}"/>
                            <DataGridTextColumn Header="Active"           Width="60"  Binding="{Binding Active}"/>
                            <DataGridTextColumn Header="Client Version"   Width="120" Binding="{Binding ClientVersion}"/>
                            <DataGridTextColumn Header="Operating System" Width="3*"  Binding="{Binding OperatingSystem}"/>
                            <DataGridTextColumn Header="Last Logon User"  Width="2*"  Binding="{Binding LastLogonUser}"/>
                            <DataGridTextColumn Header="Last Active (UTC)" Width="150" Binding="{Binding LastActive}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============================================================ -->
                <!-- View: Device                                                 -->
                <!-- ============================================================ -->
                <Grid x:Name="viewDevice" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="txtSummary" Grid.Row="0" FontSize="12" TextWrapping="Wrap" Margin="8,0,8,10"
                               Text="No inspection yet."/>
                    <WrapPanel x:Name="panelDeviceActions" Grid.Row="1" Margin="8,0,8,10">
                        <Button x:Name="btnPolicyUpdate" Content="Client Policy Update..."
                                Style="{StaticResource SquareInlineButtonStyle}"
                                ToolTip="Request and evaluate the machine policy on the device (needs Enable Actions)."/>
                        <Button x:Name="btnFullInventory" Content="Full Hardware Inventory..."
                                Style="{StaticResource SquareInlineButtonStyle}"
                                ToolTip="Delete the hardware inventory state on the device and start a full hardware inventory (needs Enable Actions)."/>
                        <Button x:Name="btnRepairInventory" Content="Repair Inventory..."
                                Style="{StaticResource SquareInlineButtonStyle}"
                                ToolTip="Run a full hardware inventory when the inventory check says Corrupt (needs Enable Actions)."/>
                    </WrapPanel>
                    <DataGrid x:Name="gridFacts" Grid.Row="2"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Group" Width="2*" Binding="{Binding Group}"/>
                            <DataGridTextColumn Header="Fact"  Width="2*" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Value" Width="4*" Binding="{Binding Value}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============================================================ -->
                <!-- View: Applications                                           -->
                <!-- ============================================================ -->
                <Grid x:Name="viewApps" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="8,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtAppFilter" Grid.Column="0" FontSize="12" Padding="6,4,6,4" Margin="0,0,8,0"
                                 Controls:TextBoxHelper.Watermark="Filter by application name..."/>
                        <ComboBox x:Name="cboAppType" Grid.Column="1" Width="180" FontSize="12"
                                  ItemContainerStyle="{StaticResource ThemedComboBoxItemStyle}"
                                  ToolTip="Limit the rows by installer type.">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="MSI"/>
                            <ComboBoxItem Content="EXE"/>
                        </ComboBox>
                    </Grid>
                    <DataGrid x:Name="gridApps" Grid.Row="1"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="menuUninstallApp" Header="Uninstall..." IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
                                <MenuItem x:Name="menuRepairApp"    Header="Repair..."    IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Application"  Width="4*" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Version"      Width="2*" Binding="{Binding Version}"/>
                            <DataGridTextColumn Header="Publisher"    Width="3*" Binding="{Binding Publisher}"/>
                            <DataGridTextColumn Header="Install Date" Width="110" Binding="{Binding InstallDate}"/>
                            <DataGridTextColumn Header="Type"         Width="70" Binding="{Binding Type}"/>
                            <DataGridTextColumn Header="View"         Width="80" Binding="{Binding View}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============================================================ -->
                <!-- View: Updates                                                -->
                <!-- ============================================================ -->
                <Grid x:Name="viewUpdates" Visibility="Collapsed">
                    <DataGrid x:Name="gridUpdates"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="menuInstallSelected" Header="Install Selected Pending Updates..." IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
                                <MenuItem x:Name="menuInstallAll"      Header="Install All Pending Updates..."      IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source"   Width="80"  Binding="{Binding Source}"/>
                            <DataGridTextColumn Header="Article"  Width="90"  Binding="{Binding Article}"/>
                            <DataGridTextColumn Header="Severity" Width="90"  Binding="{Binding Severity}"/>
                            <DataGridTextColumn Header="State"    Width="170" Binding="{Binding State}"/>
                            <DataGridTextColumn Header="Deadline (UTC)" Width="170" Binding="{Binding Deadline}"/>
                            <DataGridTextColumn Header="Title"    Width="5*"  Binding="{Binding Title}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============================================================ -->
                <!-- View: Collections                                            -->
                <!-- ============================================================ -->
                <Grid x:Name="viewCollections" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="8,0,8,8">
                        <Button x:Name="btnAddCollection" Content="Add to Collection..."
                                Style="{StaticResource SquareInlineButtonStyle}"
                                ToolTip="Add a direct membership rule for the device to a device collection (needs Enable Actions)."/>
                    </WrapPanel>
                    <DataGrid x:Name="gridCollections" Grid.Row="1"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="menuRemoveCollection" Header="Remove from Collection..." IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
                                <MenuItem x:Name="menuAddCollection" Header="Add to Collection..." IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Collection ID" Width="140" Binding="{Binding CollectionId}"/>
                            <DataGridTextColumn Header="Collection"    Width="4*"  Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Membership"    Width="170" Binding="{Binding Membership}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource MahApps.Brushes.Gray8}"
                                  ResizeDirection="Rows"/>
                    <DataGrid x:Name="gridDeployments" Grid.Row="3"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Deployment" Width="4*"  Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Type"       Width="150" Binding="{Binding Type}"/>
                            <DataGridTextColumn Header="Intent"     Width="110" Binding="{Binding Intent}"/>
                            <DataGridTextColumn Header="Collection" Width="3*"  Binding="{Binding Collection}"/>
                            <DataGridTextColumn Header="Deadline (UTC)" Width="170" Binding="{Binding Deadline}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============================================================ -->
                <!-- View: Problems                                               -->
                <!-- ============================================================ -->
                <Grid x:Name="viewProblems" Visibility="Collapsed">
                    <TextBox x:Name="txtProblems" Style="{StaticResource DetailTextStyle}"
                             Text="No inspection yet."/>
                </Grid>

                <Border x:Name="progressOverlay"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                        Opacity="0.92">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Controls:ProgressRing IsActive="True" Width="56" Height="56"
                                               Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                        <TextBlock x:Name="txtProgressTitle"
                                   Text="Inspecting..."
                                   FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0"/>
                        <TextBlock x:Name="txtProgressStep"
                                   Text=""
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray1}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource MahApps.Brushes.Gray8}"
                          ResizeDirection="Rows"/>

            <Border Grid.Row="5">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,2,4,2">
                        <TextBlock x:Name="lblLogOutput" DockPanel.Dock="Left" Text="Log Output"
                                   FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                   Margin="8,4,0,4"/>
                        <Button x:Name="btnOpenLog" DockPanel.Dock="Right" Content="Open Log File"
                                Style="{StaticResource LogButtonStyle}"
                                ToolTip="Open the log file of this session."/>
                    </DockPanel>
                    <TextBox x:Name="txtLog"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="11"
                             BorderThickness="0"
                             Margin="4,0,4,4"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="6" Padding="8,4,8,4"
                    Background="{DynamicResource MahApps.Brushes.Gray10}">
                <TextBlock x:Name="txtStatus" Text="Ready." FontSize="11"/>
            </Border>
        </Grid>
    </Grid>

</Controls:MetroWindow>