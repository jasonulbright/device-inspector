<Controls:MetroWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    Title="Device Inspector"
    Width="1320" Height="820"
    MinWidth="1024" MinHeight="640"
    WindowStartupLocation="CenterScreen"
    TitleCharacterCasing="Normal"
    GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    NonActiveGlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    BorderThickness="1"
    ShowIconOnTitleBar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Dark.Steel.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ControlTemplate x:Key="SidebarButtonTemplate" TargetType="Button">
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      SnapsToDevicePixels="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Bd" Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="#3A3A3A"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <!-- No opacity change when disabled: the sidebar colours come from SuiteCommon, and white text
                         on the light blue button (4.53:1) has no room to dim. The view buttons are never disabled. -->
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- Palette overrides for SuiteCommon (Initialize-SuiteTheme -Brushes). The start script passes every
                 resource whose key starts with 'SuiteTheme.'. The SuiteCommon defaults fail the contrast rules:
                 sidebar border #555555 on #252525 is 2.05:1, inactive light title bar #4BA3E0 is 2.6:1. -->
            <SolidColorBrush x:Key="SuiteTheme.DarkButtonBorder" Color="#808080"/>
            <SolidColorBrush x:Key="SuiteTheme.TitleBarInactive" Color="#557595"/>

            <!-- MahApps theme overrides, the same in both themes. The inactive dark title bar (#808080) gives
                 white title text 3.9:1. The text box border (#CCCCCC) is 1.6:1 on white. -->
            <SolidColorBrush x:Key="MahApps.Brushes.WindowTitle.NonActive" Color="#666666"/>
            <SolidColorBrush x:Key="MahApps.Brushes.TextBox.Border" Color="#7A7A7A"/>

            <!-- Square button without the MahApps disabled state (content at 30 percent opacity). Disabled:
                 theme colours, content at 60 percent, grey border. That keeps 4.5:1 text and 3:1 border in both themes. -->
            <ControlTemplate x:Key="AppButtonTemplate" TargetType="ButtonBase">
                <Grid>
                    <Border x:Name="AppBd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True"/>
                    <Rectangle x:Name="AppHover" Margin="{TemplateBinding BorderThickness}" Opacity="0"
                               Fill="{DynamicResource MahApps.Brushes.Gray.SemiTransparent}"/>
                    <ContentPresenter x:Name="AppContent"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True"
                                      SnapsToDevicePixels="True"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="AppHover" Property="Opacity" Value="1"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="AppHover" Property="Opacity" Value="0"/>
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray2}"/>
                        <Setter TargetName="AppContent" Property="Opacity" Value="0.6"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- The MahApps check box shows disabled text in a grey that fails 4.5:1. Keep the theme text colour;
                 the check box glyph still shows the disabled state. -->
            <Style TargetType="CheckBox" BasedOn="{StaticResource MahApps.Styles.CheckBox}">
                <Setter Property="Controls:CheckBoxHelper.ForegroundUncheckedDisabled" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                <Setter Property="Controls:CheckBoxHelper.ForegroundCheckedDisabled" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                <Setter Property="Controls:CheckBoxHelper.ForegroundIndeterminateDisabled" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
            </Style>

            <Style x:Key="ViewButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Square}">
                <Setter Property="Template" Value="{StaticResource SidebarButtonTemplate}"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Margin" Value="8,3,8,3"/>
                <Setter Property="Padding" Value="12,0,12,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Controls:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background">
                    <Setter.Value><SolidColorBrush Color="#1E1E1E"/></Setter.Value>
                </Setter>
                <Setter Property="BorderBrush">
                    <Setter.Value><SolidColorBrush Color="#555555"/></Setter.Value>
                </Setter>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="OptionsButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewButtonStyle}"/>

            <Style x:Key="SquareInlineButtonStyle" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Square}">
                <Setter Property="Template" Value="{StaticResource AppButtonTemplate}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="MinWidth" Value="100"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Controls:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="ViewDataGridRow" TargetType="DataGridRow"
                   BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ViewDataGrid" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="SelectionMode" Value="Extended"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="RowHeaderWidth" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ColumnHeaderHeight" Value="30"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource MahApps.Brushes.Gray8}"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="RowStyle" Value="{StaticResource ViewDataGridRow}"/>
            </Style>

            <Style x:Key="GridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
                <Setter Property="Padding" Value="6,0,6,0"/>
            </Style>

            <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader}">
                <Setter Property="Padding" Value="6,0,6,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style x:Key="DetailTextStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8"/>
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray1}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,14,14,12">
                    <TextBlock x:Name="txtAppTitle" Text="Device Inspector"
                               FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="txtVersion" Text="" FontSize="10"
                               Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,14">
                    <Separator Margin="0,8,0,10"/>
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock Text="Enable actions" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"/>
                        <Controls:ToggleSwitch x:Name="toggleActions"
                                               DockPanel.Dock="Right"
                                               IsOn="False"
                                               OnContent="" OffContent=""
                                               MinWidth="0"
                                               ToolTip="Off: the tool only reads. On: the action buttons can change the device or the site. Each action asks first. The switch is off at each start."/>
                    </DockPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock x:Name="txtThemeLabel" Text="Dark Theme"
                                   DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12"/>
                        <Controls:ToggleSwitch x:Name="toggleTheme"
                                               DockPanel.Dock="Right"
                                               IsOn="True"
                                               OnContent="" OffContent=""
                                               MinWidth="0"
                                               ToolTip="Toggle dark / light theme"/>
                    </DockPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button x:Name="btnViewDevice"      Content="Device"       Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Facts of the device: operating system, client health, site record"/>
                        <Button x:Name="btnViewApps"        Content="Applications" Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Installed applications on the device compared with the site inventory"/>
                        <Button x:Name="btnViewUpdates"     Content="Updates"      Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Updates that the site lists as required and updates pending on the device"/>
                        <Button x:Name="btnViewCollections" Content="Collections"  Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Collection memberships and the deployments that target them"/>
                        <Button x:Name="btnViewProblems"    Content="Problems"     Style="{StaticResource ViewButtonStyle}"
                                ToolTip="Parts of the inspection that failed"/>

                        <Button x:Name="btnOptions" Content="Options"
                                Style="{StaticResource OptionsButtonStyle}"
                                Margin="8,24,8,3"
                                ToolTip="Site server, site code, about"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource MahApps.Brushes.Gray8}"/>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource MahApps.Brushes.Gray10}" Padding="16,12,16,10">
                <StackPanel>
                    <TextBlock x:Name="txtModuleTitle" Text="Device" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtModuleSubtitle"
                               Text="Enter a device name, then click Inspect. The inspection only reads."
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Padding="16,10,16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnInspect" Grid.Column="0" Content="Inspect"
                            Style="{StaticResource SquareInlineButtonStyle}" MinWidth="120"
                            ToolTip="Read the device and the site. Nothing changes."/>
                    <TextBox x:Name="txtDevice" Grid.Column="1" FontSize="12" Padding="6,4,6,4" Margin="8,0,8,0"
                             Controls:TextBoxHelper.Watermark="Device name, e.g. WS01"/>
                    <TextBox x:Name="txtSiteServer" Grid.Column="2" FontSize="12" Padding="6,4,6,4" Margin="0,0,8,0"
                             Controls:TextBoxHelper.Watermark="Site server, e.g. sms01.example.com"/>
                    <CheckBox x:Name="chkSiteOnly" Grid.Column="3" Content="Site only" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center"
                              ToolTip="Skip the connection to the device and read only the site"/>
                    <Button x:Name="btnExportJson" Grid.Column="4" Content="Export JSON" Style="{StaticResource SquareInlineButtonStyle}"
                            ToolTip="Save the inspection as a JSON file"/>
                    <Button x:Name="btnExportHtml" Grid.Column="5" Content="Export HTML" Style="{StaticResource SquareInlineButtonStyle}" Margin="0"
                            ToolTip="Save the inspection as an HTML report"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="8,0,8,0">

                <!-- ============================================================ -->
                <!-- View: Device                                                 -->
                <!-- ============================================================ -->
                <Grid x:Name="viewDevice" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="txtSummary" Grid.Row="0" FontSize="12" TextWrapping="Wrap" Margin="8,0,8,10"
                               Text="No inspection yet."/>
                    <WrapPanel x:Name="panelDeviceActions" Grid.Row="1" Margin="8,0,8,10">
                        <Button x:Name="btnPolicyUpdate" Content="Client policy update..."
                                Style="{StaticResource SquareInlineButtonStyle}" MinWidth="170"
                                ToolTip="Request and evaluate machine policy on the device. Needs Enable actions."/>
                    </WrapPanel>
                    <DataGrid x:Name="gridFacts" Grid.Row="2"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Group" Width="2*" Binding="{Binding Group}"/>
                            <DataGridTextColumn Header="Fact"  Width="2*" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Value" Width="4*" Binding="{Binding Value}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============================================================ -->
                <!-- View: Applications                                           -->
                <!-- ============================================================ -->
                <Grid x:Name="viewApps" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="8,0,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtAppFilter" Grid.Column="0" FontSize="12" Padding="6,4,6,4" Margin="0,0,8,0"
                                 Controls:TextBoxHelper.Watermark="Filter by application name..."/>
                        <ComboBox x:Name="cboAppStatus" Grid.Column="1" Width="180" FontSize="12"
                                  ToolTip="Limit rows by comparison status">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="Match"/>
                            <ComboBoxItem Content="Version differs"/>
                            <ComboBoxItem Content="Device only"/>
                            <ComboBoxItem Content="Inventory only"/>
                        </ComboBox>
                    </Grid>
                    <DataGrid x:Name="gridApps" Grid.Row="1"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Uninstall..." IsEnabled="False" ToolTip="Planned for a later release. This release is read only."/>
                                <MenuItem Header="Repair..."    IsEnabled="False" ToolTip="Planned for a later release. This release is read only."/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Application"       Width="4*" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Device version"    Width="2*" Binding="{Binding DeviceVersion}"/>
                            <DataGridTextColumn Header="Inventory version" Width="2*" Binding="{Binding InventoryVersion}"/>
                            <DataGridTextColumn Header="Publisher"         Width="3*" Binding="{Binding Publisher}"/>
                            <DataGridTextColumn Header="Status"            Width="140" Binding="{Binding Status}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============================================================ -->
                <!-- View: Updates                                                -->
                <!-- ============================================================ -->
                <Grid x:Name="viewUpdates" Visibility="Collapsed">
                    <DataGrid x:Name="gridUpdates"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Install pending updates" IsEnabled="False" ToolTip="Planned for a later release. This release is read only."/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source"   Width="80"  Binding="{Binding Source}"/>
                            <DataGridTextColumn Header="Article"  Width="90"  Binding="{Binding Article}"/>
                            <DataGridTextColumn Header="Severity" Width="90"  Binding="{Binding Severity}"/>
                            <DataGridTextColumn Header="State"    Width="170" Binding="{Binding State}"/>
                            <DataGridTextColumn Header="Deadline (UTC)" Width="170" Binding="{Binding Deadline}"/>
                            <DataGridTextColumn Header="Title"    Width="5*"  Binding="{Binding Title}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============================================================ -->
                <!-- View: Collections                                            -->
                <!-- ============================================================ -->
                <Grid x:Name="viewCollections" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="gridCollections" Grid.Row="0"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Remove from collection" IsEnabled="False" ToolTip="Planned for a later release. This release is read only."/>
                                <MenuItem Header="Add to collection..."   IsEnabled="False" ToolTip="Planned for a later release. This release is read only."/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Collection ID" Width="140" Binding="{Binding CollectionId}"/>
                            <DataGridTextColumn Header="Collection"    Width="4*"  Binding="{Binding Name}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource MahApps.Brushes.Gray8}"
                                  ResizeDirection="Rows"/>
                    <DataGrid x:Name="gridDeployments" Grid.Row="2"
                              Style="{StaticResource ViewDataGrid}"
                              ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Deployment" Width="4*"  Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Type"       Width="150" Binding="{Binding Type}"/>
                            <DataGridTextColumn Header="Intent"     Width="110" Binding="{Binding Intent}"/>
                            <DataGridTextColumn Header="Collection" Width="3*"  Binding="{Binding Collection}"/>
                            <DataGridTextColumn Header="Deadline (UTC)" Width="170" Binding="{Binding Deadline}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ============================================================ -->
                <!-- View: Problems                                               -->
                <!-- ============================================================ -->
                <Grid x:Name="viewProblems" Visibility="Collapsed">
                    <TextBox x:Name="txtProblems" Style="{StaticResource DetailTextStyle}"
                             Text="No inspection yet."/>
                </Grid>

                <Border x:Name="progressOverlay"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                        Opacity="0.92">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Controls:ProgressRing IsActive="True" Width="56" Height="56"
                                               Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                        <TextBlock x:Name="txtProgressTitle"
                                   Text="Inspecting..."
                                   FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0"/>
                        <TextBlock x:Name="txtProgressStep"
                                   Text=""
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray1}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource MahApps.Brushes.Gray8}"
                          ResizeDirection="Rows"/>

            <Border Grid.Row="4">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,2,4,2">
                        <TextBlock x:Name="lblLogOutput" DockPanel.Dock="Left" Text="LOG OUTPUT"
                                   FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Margin="8,4,0,4"/>
                        <Button x:Name="btnOpenLog" DockPanel.Dock="Right" Content="Open log file"
                                Style="{StaticResource SquareInlineButtonStyle}" Height="24" MinWidth="110" Margin="0"
                                ToolTip="Open the full log file of this session. It holds every log line, the full report of each inspection and each action with its steps."/>
                    </DockPanel>
                    <TextBox x:Name="txtLog"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="11"
                             BorderThickness="0"
                             Margin="4,0,4,4"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="5" Padding="8,4,8,4"
                    Background="{DynamicResource MahApps.Brushes.Gray10}">
                <TextBlock x:Name="txtStatus" Text="Ready." FontSize="11"/>
            </Border>
        </Grid>
    </Grid>

</Controls:MetroWindow>